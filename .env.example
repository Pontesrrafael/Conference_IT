; Referência para configuração manual. O instalador local gera o .env automaticamente.
; Não copie este modelo sobre um ambiente já instalado.
APP_NAME="Salinas TI"
APP_URL="http://localhost:2288"
APP_KEY=
DB_HOST=127.0.0.1
DB_PORT=3308
DB_DATABASE=salinas_ti
DB_USERNAME=salinas_ti
DB_PASSWORD=
; Opcional: executável Python local utilizado para GeoTIFF.
; MAP_PYTHON="C:/caminho/python.exe"
; Somente o adaptador legado bin/coletar.php usa SGA_*.
; A interface configura a conexão no storage/sga.json, com senha cifrada.
; SGA_DSN="sqlsrv:Server=HOST,1433;Database=BASE;Encrypt=yes;TrustServerCertificate=no"
; SGA_USERNAME=
; SGA_PASSWORD=
